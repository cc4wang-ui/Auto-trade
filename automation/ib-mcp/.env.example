# ───── Connection ────────────────────────────────────────────────────────────
IB_HOST=127.0.0.1
IB_PORT=7497                # 7497 = paper TWS, 7496 = live TWS, 4002 = paper Gateway, 4001 = live Gateway
IB_CLIENT_ID=17

# ───── Safety (live trading kill switches) ───────────────────────────────────
# Hard prevent: never connect to a live-trading port unless explicitly enabled.
ENABLE_LIVE_TRADING=false

# READ_ONLY removes all order-placement tools from MCP registration.
# Use during NL strategy development to be 100% sure Claude can't trade.
READ_ONLY=false

# ───── Per-trade risk caps ───────────────────────────────────────────────────
MAX_RISK_DOLLARS_PER_TRADE=25       # rejects if (entry - stop) * qty > this
MAX_DAILY_LOSS_DOLLARS=50           # rejects new orders once today's realised loss exceeds
WATCHLIST=SOFI                      # comma-separated; empty = no whitelist (DANGEROUS)

# ───── Misc ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PAUSE_FILE=/tmp/ib-mcp-pause        # touch this file to halt all order tools

# Timezone for daily loss reset (US stocks → America/New_York)
RESET_TIMEZONE=America/New_York
